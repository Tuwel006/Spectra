{
  "name": "@spectra/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:esm && npm run build:cjs && npm run build:bundle-assets",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:bundle-assets": "node scripts/rename-cjs.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist dist-cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "@spectra/core": "workspace:*",
    "@types/express": "^5.0.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@spectra/core": "workspace:*"
  }
}