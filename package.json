{
  "name": "spectra",
  "private": true,
  "version": "0.1.0",
  "description": "Modern zero-configuration API documentation platform.",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:studio": "pnpm --filter studio dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:api": "pnpm --filter example-api dev",
    "start": "turbo run start",
    "start:studio": "pnpm --filter studio start",
    "start:docs": "pnpm --filter docs start",
    "build": "turbo run build",
    "test:nest": "tsx packages/provider-nestjs/test/controller.test.ts",
    "test:nest:decorator": "tsx packages/provider-nestjs/test/decorator.test.ts",
    "test:nest:scopes": "tsx packages/provider-nestjs/test/scopes.test.ts",
    "test:nest:order": "tsx packages/provider-nestjs/test/order.test.ts",
    "test:nest:zero": "tsx packages/provider-nestjs/test/zero-arguments.test.ts",
    "test:nest:one": "tsx packages/provider-nestjs/test/one-argument.test.ts",
    "test:nest:multi": "tsx packages/provider-nestjs/test/multiple-arguments.test.ts",
    "test:nest:string": "tsx packages/provider-nestjs/test/string-literals.test.ts",
    "test:nest:numeric": "tsx packages/provider-nestjs/test/numeric-literals.test.ts",
    "test:nest:boolean": "tsx packages/provider-nestjs/test/boolean-literals.test.ts",
    "test:nest:null": "tsx packages/provider-nestjs/test/null-literals.test.ts",
    "test:nest:identifier": "tsx packages/provider-nestjs/test/identifier-expressions.test.ts",
    "test:nest:property": "tsx packages/provider-nestjs/test/property-access.test.ts",
    "test:nest:element": "tsx packages/provider-nestjs/test/element-access.test.ts",
    "test:nest:call": "tsx packages/provider-nestjs/test/call-expressions.test.ts",
    "test:nest:array": "tsx packages/provider-nestjs/test/array-expressions.test.ts",
    "test:nest:object": "tsx packages/provider-nestjs/test/object-literals.test.ts",
    "test:ast:expression": "tsx packages/provider-ast/test/expression.test.ts",
    "test:nest:symbol": "tsx packages/provider-nestjs/test/symbol.test.ts",
    "test:nest:declaration": "tsx packages/provider-nestjs/test/declaration.test.ts",
    "test:nest:expression": "tsx packages/provider-nestjs/test/expression.test.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.4",
    "typescript": "5.9.3"
  }
